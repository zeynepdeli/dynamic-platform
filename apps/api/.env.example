# Kopyala: cp .env.example .env  — .env ASLA commit edilmez.

NODE_ENV=development
PORT=4000

# infrastructure/.env içindeki POSTGRES_* değerleriyle aynı olmalı
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5433/dynamic_platform?schema=public"

# En az 64 karakter. Üretmek için: openssl rand -base64 64
JWT_SECRET=

# Admin panelin adresi (CORS). Production'da https:// zorunlu.
FRONTEND_URL=http://localhost:3001

# API önünde kaç güvenilir reverse proxy var? (Nginx/Cloudflare: 1, yoksa 0)
TRUST_PROXY_HOPS=0

# Yalnızca scripts/create-admin.ts için (en az 12 karakter)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ───── Görsel depolama ─────
# local: sunucu diski (storage/media) — sunucu yenilenirse kaybolabilir, yedekleyin.
# cloudinary: Cloudinary hesabı (önerilen). Bilgiler: Cloudinary → Settings → API Keys
MEDIA_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Her müşteri için ayrı klasör (ör. musteri-adi)
CLOUDINARY_FOLDER=dynamic-platform

# ───── E-posta (SMTP) — boş bırakılırsa e-posta gönderilmez ─────
# Yeni mesaj bildirimi ve "şifremi unuttum" için gerekli.
# Örnekler: Gmail → smtp.gmail.com:587 (uygulama şifresi), Brevo → smtp-relay.brevo.com:587,
#           Resend → smtp.resend.com:465 (SMTP_SECURE=true)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Web sitesi ↔ API ortak gizli anahtar (web/.env içindeki WEB_API_SECRET ile AYNI).
# İletişim formunda hız sınırı ziyaretçi bazında çalışsın diye. Üret: openssl rand -hex 32
WEB_API_SECRET=
