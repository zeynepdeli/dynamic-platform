// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Menünün sitedeki yeri
enum MenuLocation {
  HEADER
  FOOTER
}

model SiteSettings {
  id String @id @default("main")

  siteName    String
  description String?

  logoUrl    String?
  faviconUrl String?

  primaryColor   String @default("#183350")
  secondaryColor String @default("#346872")

  // Site arka planı: renk her zaman, fotoğraf varsa rengin üstünde
  backgroundColor String  @default("#FFFFFF")
  backgroundImage String?

  // Header: arka plan (boşsa ana renk) + isteğe bağlı buton
  headerBackgroundColor String?
  headerBackgroundImage String?
  headerButtonText      String?
  headerButtonHref      String?

  // Ana sayfaya özel arka plan (boşsa genel arka plan)
  homeBackgroundColor String?
  homeBackgroundImage String?

  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  // Paylaşımlarda görünen varsayılan görsel (OpenGraph)
  ogImageUrl      String?
  // false: tüm site arama motorlarına kapalı (yapım aşaması)
  allowIndexing   Boolean @default(true)
  // Google Analytics 4 ölçüm kimliği (yalnızca G-XXXXXXX; serbest kod YOK)
  gaMeasurementId String?

  // Yeni iletişim mesajı gelince bildirim gönderilecek adres
  notifyEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Page {
  id        String    @id @default(uuid())
  title     String
  slug      String    @unique
  content   String?
  published Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  ogImageUrl     String?
  noIndex        Boolean   @default(false)

  // Sayfaya özel arka plan (boşsa site genel arka planı)
  backgroundColor String?
  backgroundImage String?

  sections Section[]
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  // Bu tarihten önce verilen oturumlar geçersiz (şifre değişince)
  passwordChangedAt DateTime?

  sessions    RefreshSession[]
  resetTokens PasswordResetToken[]
  role         UserRole @default(USER)
  active       Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id String @id @default(uuid())

  label String
  href  String
  // Whitelist anahtarı (common/icons.ts → MENU_ICON_KEYS). Boş = ikonsuz
  icon  String?

  // HEADER: üst menü (2 seviye) · FOOTER: footer linkleri (tek seviye)
  location MenuLocation @default(HEADER)

  order   Int     @default(0)
  visible Boolean @default(true)

  parentId String?
  parent   MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children MenuItem[] @relation("MenuHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([location, parentId, order])
}

model HeroSlide {
  id String @id @default(uuid())

  title       String
  subtitle    String?
  description String?

  imageUrl       String?
  mobileImageUrl String?

  buttonText String?
  buttonHref String?

  order  Int     @default(0)
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

model Media {
  id String @id @default(uuid())

  originalName String
  storageKey   String @unique
  mimeType     String
  size         Int

  url String

  // Görselin açıklaması (erişilebilirlik ve SEO için <img alt>)
  alt String?

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model FooterSettings {
  id           String  @id @default("main")
  description  String?
  copyright    String?
  email        String?
  phone        String?
  address      String?
  enabled      Boolean @default(true)

  backgroundColor String?
  backgroundImage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Yönetici oturumları: kısa ömürlü JWT + dönen (rotating) yenileme anahtarı.
// Anahtarın kendisi değil SHA-256 özeti saklanır.
model RefreshSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  // Kullanılmadan geçebilecek süre (her yenilemede uzar)
  expiresAt         DateTime
  // Hiçbir şekilde aşılamayan üst sınır
  absoluteExpiresAt DateTime
  // Yenilenince/çıkış yapılınca dolar; tekrar kullanılırsa çalınma şüphesi
  revokedAt         DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// "Şifremi unuttum" bağlantıları: tek kullanımlık, 30 dk, yalnızca özet saklanır
model PasswordResetToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

// Sitedeki iletişim formundan gelen mesajlar
model ContactMessage {
  id String @id @default(uuid())

  name    String
  email   String
  phone   String?
  subject String?
  message String

  read Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([read, createdAt])
  @@index([createdAt])
}

// Footer'daki sosyal medya bağlantıları (ikon + adres, sıralanabilir)
model SocialLink {
  id String @id @default(uuid())

  // Whitelist anahtarı (common/icons.ts → SOCIAL_ICON_KEYS)
  icon  String
  // Erişilebilirlik etiketi; boşsa platform adı kullanılır
  label String?
  url   String

  order   Int     @default(0)
  visible Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

enum SectionType {
  CARDS // Kart ızgarası (hizmetler, ürünler vb.)
  TEXT // Başlık + düz metin
  IMAGE_TEXT // Yanda görsel, yanda metin
  CTA // Çağrı alanı (başlık + buton)
  FAQ // Sıkça sorulan sorular (öğe: soru + cevap)
  GALLERY // Galeri (öğe: görsel + alt yazı)
  VIDEO // YouTube / Vimeo videosu
  MAP // Adres + harita
  STATS // Sayılar (öğe: "500+" + açıklama)
  CONTACT_FORM // İletişim formu (mesajlar → Gelen Mesajlar)
}

model Section {
  id String @id @default(uuid())

  // null = ana sayfa bölümü
  pageId String?
  page   Page?   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  // Geliştirici anahtarı (ör. "vizyon"). Frontend bölümü bununla bulur.
  // Aynı sayfada tekrar edemez. Boş = serbest bölüm.
  key String?

  type     SectionType @default(CARDS)
  title    String?
  subtitle String?
  body     String? // Düz metin (HTML DEĞİL)

  backgroundColor String? // #RRGGBB
  backgroundImage String? // /media/... veya https://...
  textColor       String? // #RRGGBB

  buttonText String?
  buttonHref String?

  // Kart ızgarası kaç sütun olsun (masaüstü)
  // VIDEO: YouTube/Vimeo adresi · MAP: haritada gösterilecek adres
  videoUrl   String?
  mapAddress String?

  columns Int @default(3)

  order  Int     @default(0)
  active Boolean @default(true)

  items SectionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageId, key])
  @@index([pageId, active, order])
}

model SectionItem {
  id String @id @default(uuid())

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  title       String
  description String?
  imageUrl    String?
  icon        String? // İkon adı (ör. "truck"), serbest SVG DEĞİL

  buttonText String?
  buttonHref String?

  backgroundColor String? // Karta özel renk (#RRGGBB), boşsa bölüm/tema rengi
  backgroundImage String? // Karta özel arka plan fotoğrafı

  order  Int     @default(0)
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId, active, order])
}

// ───────────── E-ticaret: katalog (COMMERCE_ENABLED=true ise kullanılır) ─────────────

model ProductCategory {
  id String @id @default(uuid())

  name        String
  slug        String  @unique
  description String?
  imageUrl    String?

  order  Int     @default(0)
  active Boolean @default(true)

  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([active, order])
}

model Product {
  id String @id @default(uuid())

  name String
  slug String  @unique
  // Stok kodu (isteğe bağlı, benzersiz)
  sku  String? @unique

  // Kartlarda görünen kısa açıklama
  summary     String?
  description String?

  price          Decimal  @db.Decimal(12, 2)
  // Üstü çizili eski fiyat (indirim gösterimi)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  // Satış birimi etiketi (ör. "500 g", "Adet")
  unit           String?

  stock      Int     @default(0)
  // Kapalıysa stok düşülmez/kontrol edilmez (ör. sınırsız dijital ürün)
  trackStock Boolean @default(true)

  active   Boolean @default(true)
  featured Boolean @default(false)

  metaTitle       String?
  metaDescription String?

  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  images ProductImage[]
  tabs   ProductTab[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, categoryId])
  @@index([active, featured])
  @@index([createdAt])
}

model ProductImage {
  id String @id @default(uuid())

  url   String
  alt   String?
  order Int     @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, order])
}

// Ürün detayındaki sekmeler (ör. Hikaye, Özellikler, Nasıl Servis Edilir?)
model ProductTab {
  id String @id @default(uuid())

  title String
  body  String
  order Int    @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, order])
}
