// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BackgroundType {
  COLOR
  IMAGE
}

model SiteSettings {
  id String @id @default("main")

  siteName    String
  description String?

  logoUrl    String?
  faviconUrl String?

  primaryColor   String @default("#183350")
  secondaryColor String @default("#346872")

  backgroundType  BackgroundType @default(COLOR)
  backgroundColor String         @default("#FFFFFF")
  backgroundImage String?

  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Page {
  id        String    @id @default(uuid())
  title     String
  slug      String    @unique
  content   String?
  published Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  ogImageUrl     String?
  noIndex        Boolean @default(false)
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  active       Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id String @id @default(uuid())

  label String
  href  String

  order   Int     @default(0)
  visible Boolean @default(true)

  parentId String?
  parent   MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children MenuItem[] @relation("MenuHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, order])
}

model HeroSlide {
  id String @id @default(uuid())

  title       String
  subtitle    String?
  description String?

  imageUrl       String?
  mobileImageUrl String?

  buttonText String?
  buttonHref String?

  order  Int     @default(0)
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

model Media {
  id String @id @default(uuid())

  originalName String
  storageKey   String @unique
  mimeType     String
  size         Int

  url String

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model FooterSettings {
  id           String  @id @default("main")
  description  String?
  copyright    String?
  email        String?
  phone        String?
  address      String?
  facebookUrl  String?
  instagramUrl String?
  linkedinUrl  String?
  youtubeUrl   String?
  githubUrl    String?
  enabled      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
