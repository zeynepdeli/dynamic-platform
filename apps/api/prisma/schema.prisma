// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BackgroundType {
  COLOR
  IMAGE
}

model SiteSettings {
  id String @id @default("main")

  siteName    String
  description String?

  logoUrl    String?
  faviconUrl String?

  primaryColor   String @default("#183350")
  secondaryColor String @default("#346872")

  backgroundType  BackgroundType @default(COLOR)
  backgroundColor String         @default("#FFFFFF")
  backgroundImage String?

  // Ana sayfaya özel arka plan (boşsa genel arka plan)
  homeBackgroundColor String?
  homeBackgroundImage String?

  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Page {
  id        String    @id @default(uuid())
  title     String
  slug      String    @unique
  content   String?
  published Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  ogImageUrl     String?
  noIndex        Boolean   @default(false)

  // Sayfaya özel arka plan (boşsa site genel arka planı)
  backgroundColor String?
  backgroundImage String?

  sections Section[]
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  active       Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id String @id @default(uuid())

  label String
  href  String
  // Whitelist anahtarı (common/icons.ts → MENU_ICON_KEYS). Boş = ikonsuz
  icon  String?

  order   Int     @default(0)
  visible Boolean @default(true)

  parentId String?
  parent   MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children MenuItem[] @relation("MenuHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, order])
}

model HeroSlide {
  id String @id @default(uuid())

  title       String
  subtitle    String?
  description String?

  imageUrl       String?
  mobileImageUrl String?

  buttonText String?
  buttonHref String?

  order  Int     @default(0)
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

model Media {
  id String @id @default(uuid())

  originalName String
  storageKey   String @unique
  mimeType     String
  size         Int

  url String

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model FooterSettings {
  id           String  @id @default("main")
  description  String?
  copyright    String?
  email        String?
  phone        String?
  address      String?
  enabled      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Footer'daki sosyal medya bağlantıları (ikon + adres, sıralanabilir)
model SocialLink {
  id String @id @default(uuid())

  // Whitelist anahtarı (common/icons.ts → SOCIAL_ICON_KEYS)
  icon  String
  // Erişilebilirlik etiketi; boşsa platform adı kullanılır
  label String?
  url   String

  order   Int     @default(0)
  visible Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

enum SectionType {
  CARDS // Kart ızgarası (hizmetler, ürünler vb.)
  TEXT // Başlık + düz metin
  IMAGE_TEXT // Yanda görsel, yanda metin
  CTA // Çağrı alanı (başlık + buton)
}

model Section {
  id String @id @default(uuid())

  // null = ana sayfa bölümü
  pageId String?
  page   Page?   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  // Geliştirici anahtarı (ör. "vizyon"). Frontend bölümü bununla bulur.
  // Aynı sayfada tekrar edemez. Boş = serbest bölüm.
  key String?

  type     SectionType @default(CARDS)
  title    String?
  subtitle String?
  body     String? // Düz metin (HTML DEĞİL)

  backgroundColor String? // #RRGGBB
  backgroundImage String? // /media/... veya https://...
  textColor       String? // #RRGGBB

  buttonText String?
  buttonHref String?

  // Kart ızgarası kaç sütun olsun (masaüstü)
  columns Int @default(3)

  order  Int     @default(0)
  active Boolean @default(true)

  items SectionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageId, key])
  @@index([pageId, active, order])
}

model SectionItem {
  id String @id @default(uuid())

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  title       String
  description String?
  imageUrl    String?
  icon        String? // İkon adı (ör. "truck"), serbest SVG DEĞİL

  buttonText String?
  buttonHref String?

  backgroundColor String? // Karta özel renk (#RRGGBB), boşsa bölüm/tema rengi

  order  Int     @default(0)
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId, active, order])
}
