# Kopyala: cp .env.example .env.local
# Yalnızca sunucu tarafında okunur (NEXT_PUBLIC_ öneki YOK, tarayıcıya sızmaz)
API_URL=http://localhost:4000

# Herkese açık API adresi (admin'de görsel önizlemeleri için). Boşsa API_URL.
API_PUBLIC_URL=

# API ile ortak gizli anahtar (api/.env içindeki WEB_API_SECRET ile AYNI).
# Giriş/şifre sıfırlama hız sınırı kişi bazında çalışsın diye.
WEB_API_SECRET=
