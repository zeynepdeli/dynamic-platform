# Kopyala: cp .env.example .env.local
# Yalnızca sunucu tarafında okunur (NEXT_PUBLIC_ öneki YOK, tarayıcıya sızmaz)

# Next sunucusunun API'ye ulaştığı adres
API_URL=http://localhost:4000

# Ziyaretçinin tarayıcısının görsellere ulaşacağı adres
# (production'da ör. https://api.siteadi.com). Boşsa API_URL kullanılır.
API_PUBLIC_URL=

# Admin'deki değişikliklerin sitede görünme süresi (saniye)
REVALIDATE_SECONDS=30
