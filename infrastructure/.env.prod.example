# Kopyala: cp .env.prod.example .env.prod  — .env.prod ASLA commit edilmez.
# Gizli değerleri üretmek için:  openssl rand -hex 32   (JWT için: openssl rand -base64 64)

COMPOSE_PROJECT_NAME=musteri-adi

# ── Alan adları (DNS A kayıtları bu sunucuyu göstermeli) ──
SITE_DOMAIN=siteadi.com
ADMIN_DOMAIN=admin.siteadi.com
API_DOMAIN=api.siteadi.com
# Let's Encrypt sertifika bildirimleri için
ACME_EMAIL=

# ── Veritabanı ──
POSTGRES_USER=dp
POSTGRES_PASSWORD=
POSTGRES_DB=dynamic_platform

# ── Gizli anahtarlar ──
# En az 64 karakter
JWT_SECRET=
# En az 32 karakter; web, admin ve API ortak kullanır
WEB_API_SECRET=

# ── İlk yönetici (yalnızca create-admin komutunda kullanılır; sonra silebilirsiniz) ──
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Örnek içerikteki site adı (db:seed)
SEED_SITE_NAME=

# ── Görseller: local (sunucu diski, "media" volume) veya cloudinary (önerilen) ──
MEDIA_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=musteri-adi

# ── E-posta (boşsa e-posta gönderilmez; "şifremi unuttum" ve mesaj bildirimi için gerekli) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

REVALIDATE_SECONDS=30

# ── Modüller ──
# E-ticaret (ürün/kategori yönetimi ve mağaza API'si)
COMMERCE_ENABLED=false
